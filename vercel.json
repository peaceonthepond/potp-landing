{
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/corporate",
      "destination": "/corporate.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "corporate.peaceonthepond.com"
        }
      ],
      "destination": "/corporate",
      "permanent": false
    }
  ]
}
